<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.naturehoney.*" %><%
 Product x=null;try{x=new ProductDAO().get(Integer.parseInt(request.getParameter("id")));}catch(Exception ignored){}
%><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Product | NatureHoney</title><link rel="stylesheet" href="assets/style.css"></head><body><header class="top"><a class="brand" href="index.jsp">🍯 NatureHoney</a><nav><a href="index.jsp">Home</a><a href="index.jsp#products">Shop Honey</a></nav></header><main class="wrap detail">
